# EXAMPLE, not applied by Flux (.example extension, not listed in kustomization.yml): this is
# the "create another VM to scale runners" step the gh-runners Project/Network/Profile exist for.
# Copy this to a real .yml, give it a unique metadata.name/external-name, and fill in a registration
# token before applying - see the caveats in gh-runner-profile.yml about where that token should
# really come from (not hardcoded here for real use, this file is illustrative).
#
# Registration tokens expire in about an hour: generate one right before applying this
# (Settings > Actions > Runners > New runner, on the phorge-fr org/repo), not in advance.
apiVersion: instance.incus.crossplane.io/v1alpha1
kind: Instance
metadata:
    name: gh-runner-1
    annotations:
        crossplane.io/external-name: gh-runner-1
spec:
    forProvider:
        type: virtual-machine
        image: images:alpine/edge/cloud
        profiles:
            - gh-runner
        config:
            cloud-init.user-data: |
                #cloud-config
                runcmd:
                    - adduser -D -h /home/ghrunner ghrunner
                    - su ghrunner -c "cd /home/ghrunner && github-act-runner new --url https://github.com/phorge-fr --name $(hostname) --labels self-hosted,phorge,alpine --token REPLACE_WITH_A_FRESH_REGISTRATION_TOKEN"
                    - rc-update add gh-runner default
                    - rc-service gh-runner start
        projectRef:
            name: gh-runners
    providerConfigRef:
        name: default
